# TETUKO - Teknologi Terpadu Komprehensif
# Semua konfigurasi terpusat di file ini. Salin ke .env dan sesuaikan bila perlu.
# JANGAN commit file .env yang berisi nilai rahasia/produksi.

# ── Firebase / Firestore (penyimpanan login & kredensial, tanpa Firebase Auth) ─
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_FIREBASE_MEASUREMENT_ID
VITE_APP_SECRET=YOUR_APP_SECRET
VITE_PAYLOAD_KEY=YOUR_PAYLOAD_KEY

# ── Profil Jatim (Provinsi Jawa Timur) ───────────────────────────────
VITE_JATIM_ID=jatim
VITE_JATIM_NAME=Provinsi Jawa Timur
VITE_JATIM_LABEL=Presensi Jatimprov
VITE_JATIM_GATEWAY_URL=https://presensi.bkd.jatimprov.go.id/service
VITE_JATIM_EP_BASE_URL=https://presensi.bkd.jatimprov.go.id
VITE_JATIM_MODE=bkd-rpc
VITE_JATIM_REQUIRES_PHOTO=false
VITE_JATIM_REQUIRES_WORKCODE=true

# ── Profil Madiun (Kabupaten Madiun) ─────────────────────────────────
VITE_MADIUN_ID=madiun
VITE_MADIUN_NAME=Kabupaten Madiun
VITE_MADIUN_LABEL=Presensi Madiunkab
VITE_MADIUN_GATEWAY_URL=https://absen.madiunkab.go.id/service
VITE_MADIUN_EP_BASE_URL=https://presensimadiun.appdev.web.id
VITE_MADIUN_MODE=bkd-rpc
VITE_MADIUN_REQUIRES_PHOTO=false
VITE_MADIUN_REQUIRES_WORKCODE=true

# ── Profil Ponorogo (Kabupaten Ponorogo) ─────────────────────────────
VITE_PONOROGO_ID=ponorogo
VITE_PONOROGO_NAME=Kabupaten Ponorogo
VITE_PONOROGO_LABEL=Presensi Ponorogo
VITE_PONOROGO_GATEWAY_URL=https://presensi.ponorogo.go.id/service
VITE_PONOROGO_EP_BASE_URL=https://presensi.ponorogo.go.id
VITE_PONOROGO_MODE=ponorogo-absensi
VITE_PONOROGO_REQUIRES_PHOTO=true
VITE_PONOROGO_REQUIRES_WORKCODE=false
VITE_PONOROGO_API_BASE=http://103.109.206.102:8089/Ponorogo-absensApi/index.php
VITE_PONOROGO_IMAGE_BASE=http://103.109.206.102:8087

# ── Aplikasi / Deploy ────────────────────────────────────────────────
VITE_LOCAL_API_PORT=14200
